#!/usr/bin/python3
# Print the GitHub Copilot CLI usage record as JSON for the Omarchy agents panel.
#
# Same record contract as /usr/share/omarchy/bin/omarchy-agent-usage-claude.
# Local stats come from ~/.copilot/session-state/*/events.jsonl
# (session.usage_record events); the monthly premium-request limit comes from
# GitHub's copilot_internal/user endpoint via the signed-in `gh` CLI.
#
# Run with --write to drop the record into ~/.local/state/omarchy/agents/usage/.

import datetime as dt
import json
import os
import subprocess
import sys
from pathlib import Path
from typing import Any

COPILOT_HOME = Path(os.environ.get("COPILOT_HOME", Path.home() / ".copilot"))
USAGE_DIR = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "omarchy/agents/usage"

SKU_LABELS = {
  "free_educational_quota": "Education",
  "free_limited_copilot": "Free",
  "copilot_pro": "Pro",
  "copilot_pro_plus": "Pro+",
}


def local_day(timestamp: str) -> str:
  try:
    moment = dt.datetime.fromisoformat(timestamp.replace("Z", "+00:00"))
  except ValueError:
    return ""
  return moment.astimezone().strftime("%Y-%m-%d")


def number(value: Any) -> int:
  try:
    return max(0, int(value or 0))
  except (TypeError, ValueError):
    return 0


def scan_sessions() -> dict[str, Any]:
  today = dt.datetime.now().strftime("%Y-%m-%d")
  recent = [(dt.date.today() - dt.timedelta(days=offset)).isoformat() for offset in range(6, -1, -1)]
  daily = {day: 0 for day in recent}
  model_usage: dict[str, dict[str, int]] = {}
  today_by_model: dict[str, int] = {}
  active_dates: set[str] = set()
  seen: set[str] = set()
  sessions: set[str] = set()
  today_sessions: set[str] = set()
  prompts = today_prompts = 0

  for events in (COPILOT_HOME / "session-state").glob("*/events.jsonl"):
    session_id = events.parent.name
    try:
      lines = events.read_text(errors="replace").splitlines()
    except OSError:
      continue
    for line in lines:
      if '"session.usage_record"' not in line and '"user.message"' not in line:
        continue
      try:
        event = json.loads(line)
      except json.JSONDecodeError:
        continue
      day = local_day(str(event.get("timestamp", "")))
      if not day:
        continue

      if event.get("type") == "user.message":
        prompts += 1
        if day == today:
          today_prompts += 1
        continue

      if event.get("type") != "session.usage_record":
        continue
      # A resumed session can replay records; the event id keeps them single.
      event_id = str(event.get("id", ""))
      if event_id in seen:
        continue
      seen.add(event_id)

      usage = (event.get("data") or {}).get("usage") or {}
      model = str(usage.get("model") or "unknown")
      cache_read = number(usage.get("cacheReadTokens"))
      cache_write = number(usage.get("cacheWriteTokens"))
      # Copilot reports inputTokens including the cached part.
      input_total = number(usage.get("inputTokens"))
      output = number(usage.get("outputTokens"))
      total = input_total + output

      bucket = model_usage.setdefault(model, {
        "inputTokens": 0,
        "outputTokens": 0,
        "cacheReadInputTokens": 0,
        "cacheCreationInputTokens": 0,
      })
      bucket["inputTokens"] += max(0, input_total - cache_read - cache_write)
      bucket["outputTokens"] += output
      bucket["cacheReadInputTokens"] += cache_read
      bucket["cacheCreationInputTokens"] += cache_write

      active_dates.add(day)
      sessions.add(session_id)
      if day in daily:
        daily[day] += total
      if day == today:
        today_sessions.add(session_id)
        today_by_model[model] = today_by_model.get(model, 0) + total

  return {
    "hasLocalStats": bool(seen),
    "todayPrompts": today_prompts,
    "todaySessions": len(today_sessions),
    "todayTotalTokens": sum(today_by_model.values()),
    "todayTokensByModel": today_by_model,
    "totalPrompts": prompts,
    "totalSessions": len(sessions),
    "activeDays": len(active_dates),
    "activeDates": sorted(active_dates),
    "recentDays": [{"date": day, "messageCount": daily[day]} for day in recent],
    "modelUsage": model_usage,
  }


def fetch_quota() -> tuple[list[dict[str, Any]], str, str]:
  try:
    result = subprocess.run(
      ["gh", "api", "/copilot_internal/user"],
      capture_output=True, text=True, timeout=20,
    )
    payload = json.loads(result.stdout) if result.returncode == 0 else None
  except (OSError, subprocess.TimeoutExpired, json.JSONDecodeError):
    payload = None
  if not isinstance(payload, dict):
    return [], "", "Could not reach GitHub — run `gh auth login`."

  tier = SKU_LABELS.get(str(payload.get("access_type_sku", "")), str(payload.get("copilot_plan", "")).title())
  premium = (payload.get("quota_snapshots") or {}).get("premium_interactions") or {}
  limits = []
  if premium and not premium.get("unlimited"):
    entitlement = float(premium.get("entitlement") or 0)
    remaining = float(premium.get("percent_remaining", 100))
    used = round(entitlement - float(premium.get("quota_remaining", entitlement)), 1)
    reset = str(payload.get("quota_reset_date") or "")
    reset_at = dt.datetime.fromisoformat(reset).astimezone().isoformat() if reset else ""
    limits.append({
      "label": f"Monthly premium requests ({used:g}/{entitlement:g})",
      "title": "Premium (monthly)",
      "percent": round(max(0.0, min(1.0, 1 - remaining / 100)), 4),
      "resetsAt": reset_at,
    })
  return limits, tier, ""


def main() -> int:
  stats = scan_sessions()
  limits, tier, status = fetch_quota()
  record = {
    "schemaVersion": 1,
    "id": "copilot",
    "name": "GitHub Copilot",
    "updatedAt": dt.datetime.now(dt.timezone.utc).isoformat(),
    "ready": True,
    **stats,
    "limits": limits,
    "tierLabel": tier,
    "usageStatusText": status,
    "authHelpText": "Run `gh auth login` and `copilot login` to restore usage.",
  }
  text = json.dumps(record, indent=2, sort_keys=True)

  if "--write" in sys.argv:
    USAGE_DIR.mkdir(parents=True, exist_ok=True)
    tmp = USAGE_DIR / ".copilot.json.tmp"
    tmp.write_text(text + "\n")
    tmp.replace(USAGE_DIR / "copilot.json")
  else:
    print(text)
  return 0


if __name__ == "__main__":
  sys.exit(main())
